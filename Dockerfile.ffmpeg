# Use an LTS base so we control all deps. You can swap to your ghcr base if preferred.
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG FFMPEG_TAG=master
ARG NVCC_FLAGS="-gencode arch=compute_75,code=sm_75 -gencode arch=compute_75,code=compute_75 -O2"
ARG MAKEFLAGS="-j$(nproc)"

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf automake build-essential cmake git wget curl pkg-config texinfo \
    yasm nasm libtool libx264-dev libx265-dev libnuma-dev zlib1g-dev \
    libfdk-aac-dev libvpx-dev libvorbis-dev libopus-dev libssl-dev \
    ca-certificates unzip python3 python3-pip gettext liblzma-dev libbz2-dev \
    libxcb1-dev libxcb-shm0-dev libxcb-xfixes0-dev libxcb-shape0-dev \
    libogg-dev meson ninja-build && \
    rm -rf /var/lib/apt/lists/*

# Create workspace
WORKDIR /usr/src

# ----------------------
# Build and install libdav1d (preferred AV1 software decoder)
# ----------------------
RUN git clone --depth 1 https://code.videolan.org/videolan/dav1d.git && \
    cd dav1d && \
    meson setup build -Ddefault_library=both || true && \
    ninja -C build && \
    ninja -C build install && \
    ldconfig

# ----------------------
# Build and install libaom (alternate AV1 encoder/decoder)
# ----------------------
RUN git clone --depth 1 https://aomedia.googlesource.com/aom && \
    mkdir -p aom/build && cd aom/build && \
    cmake -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=1 .. && \
    make -j$(nproc) && make install && \
    ldconfig

# ----------------------
# Build and install libvmaf (so FFmpeg will accept external JSON models)
# ----------------------
RUN git clone --depth 1 https://github.com/Netflix/vmaf.git && \
    cd vmaf/libvmaf && \
    ./configure --prefix=/usr/local && \
    make -j$(nproc) && make install && \
    ldconfig

# (optional) copy a vmaf model into the image so tests can reference it easily
# You can GET a model and COPY here, or mount it at runtime.
# Example (uncomment to fetch model at build-time):
# RUN mkdir -p /usr/local/share/model && \
#     wget -O /usr/local/share/model/vmaf_v0.6.1.json https://raw.githubusercontent.com/Netflix/vmaf/master/model/vmaf_v0.6.1.json

# ----------------------
# Build FFmpeg
# ----------------------
# Download FFmpeg source (use tag or master per arg)
RUN wget -qO- "https://github.com/FFmpeg/FFmpeg/archive/${FFMPEG_TAG}.zip" > ffmpeg.zip && unzip ffmpeg.zip && mv FFmpeg-${FFMPEG_TAG} ffmpeg-src

WORKDIR /usr/src/ffmpeg-src

# Configure FFmpeg
# NOTE: we purposefully do NOT enable --enable-nvdec to prevent hw AV1 decode probing.
RUN ./configure \
    --prefix=/usr/local \
    --pkg-config-flags="--static" \
    --extra-cflags="-I/usr/local/include" \
    --extra-ldflags="-L/usr/local/lib" \
    --extra-libs="-lpthread -lm" \
    --enable-gpl \
    --enable-nonfree \
    --enable-libdav1d \
    --enable-libaom \
    --enable-libvmaf \
    --enable-libx264 \
    --enable-libx265 \
    --enable-libvpx \
    --enable-libfdk-aac \
    --enable-libopus \
    --enable-libvorbis \
    --enable-libssl \
    --enable-libxcb \
    --enable-libxcb-shm \
    --enable-libxcb-xfixes \
    --enable-libxcb-shape \
    --enable-libavfilter \
    --enable-pic \
    --enable-small \
    --enable-postproc \
    --enable-runtime-cpudetect \
    --enable-libdrm \
    --enable-nvenc \
    --enable-cuvid \
    --enable-cuda \
    --nvccflags="${NVCC_FLAGS}" \
    --disable-debug

# Build and install
RUN make ${MAKEFLAGS} && make install && ldconfig

# Add a directory for results and default entrypoint
RUN mkdir -p /data /models /results

# Put vmaf model path in a standard place if you want to COPY it at build time:
# COPY vmaf_v0.6.1.json /models/vmaf_v0.6.1.json

ENV PATH="/usr/local/bin:${PATH}"
WORKDIR /data

ENTRYPOINT ["ffmpeg"]
